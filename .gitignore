# --- data and checkpoints: never commit, these are 100 MB - 600 MB each ---
*.pkl
*.pth
*.bin
*.npy
*.npz
work_dirs/
cache/
data/
infos/

# --- run outputs ---
*.log
outputs_*.log
# ...but the released per-run evaluation logs are the point of results/
!results/**/*.log
nohup.out
*.out

# --- python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# --- the manuscript must never land in this repository ---
# This is a public code release. The paper source, its bibliography, its
# figures-as-typeset and any compiled PDF stay out. If a future release needs
# to ship a figure, add that one file with `git add -f`.
*.tex
*.bib
*.pdf
*.sty
*.cls
*.bst
paper/
paper-*/
manuscript/
release-notes/

# --- LaTeX build artifacts (belt and braces; the sources are excluded above) ---
*.aux
*.bbl
*.blg
*.brf
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
*.swp
